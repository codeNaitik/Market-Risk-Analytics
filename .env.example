# Copy to .env and fill in. .env is git-ignored. Never commit real keys.

# Where the lake lives. Local folder for development, ADLS Gen2 in the cloud.
LAKE_ROOT=./lake
# LAKE_ROOT=abfss://lake@<storage-account>.dfs.core.windows.net

# Azure auth for adlfs when LAKE_ROOT is abfss:// (service principal from Terraform output)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# SEC requires a descriptive User-Agent with a contact email
SEC_USER_AGENT="Your Name your.email@example.com"

# Kafka (docker-compose default). For Azure Event Hubs use <namespace>.servicebus.windows.net:9093
KAFKA_BOOTSTRAP=localhost:9092
# KAFKA_SASL_JAAS=org.apache.kafka.common.security.plain.PlainLoginModule required username="$ConnectionString" password="<event-hubs-connection-string>";

# dbt -> Databricks SQL Warehouse (DBT_TARGET=databricks)
DBT_TARGET=dev
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=market_risk
